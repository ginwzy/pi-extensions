{
  "name": "@ginwzy/pi-extensions",
  "version": "0.1.0",
  "description": "All-in-One Pi extension package maintained in the ginwzy/pi-extensions repository.",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ginwzy/pi-extensions.git"
  },
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-shell/index.ts",
      "./extensions/pi-tool-display/index.ts",
      "./extensions/pi-tasks/index.ts",
      "./extensions/pi-rewind/src/index.ts"
    ],
    "skills": [
      "!skills/**"
    ],
    "prompts": [],
    "themes": []
  },
  "scripts": {
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/extensions/pi-shell/src/*.test.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "^1.3.10"
  }
}
